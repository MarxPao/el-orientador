# ==============================================================================
# EL ORIENTADOR — Configurações de Ambiente (Beta)
# ==============================================================================

# Backend / Pipeline
# Chave de segurança para tokens JWT (mínimo de 32 caracteres obrigatório)
JWT_SECRET=defina-aqui-uma-chave-secreta-com-pelo-menos-32-caracteres

# Banco de dados PostgreSQL + pgvector
DATABASE_URL=postgresql://orientador:orientador_secret_pass_123@localhost:5432/orientador_db

# Armazenamento local de PDFs (pasta no disco, sem limite de tamanho além do disco)
STORAGE_DIR=storage
# Tamanho maximo de cada PDF em MB (0 ou vazio = sem limite; e um app local)
MAX_PDF_MB=0

# Provedor de LLM: gemini (padrão) ou grok (API da xAI). O modelo é livre: use o nome que a sua conta oferece.
LLM_PROVIDER=gemini
LLM_API_KEY=sua-chave-api-aqui
# Gemini: gemini-2.0-flash (padrão do código). Grok: grok-4 (padrão do código). Troque pelo modelo que quiser.
LLM_MODEL=
# Opcional. Vazio = o endereço oficial do provedor. Gemini: https://generativelanguage.googleapis.com/v1beta
# Grok: https://api.x.ai/v1  (qualquer serviço compatível com a API "chat/completions" funciona com LLM_PROVIDER=grok)
LLM_BASE_URL=
# Grok não oferece embeddings neste projeto: a busca por significado usa o modelo local (EMBED_PROVIDER=local).

# CORS: origens autorizadas para o frontend web
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dados de demonstração (1 para carregar projeto e artigos de exemplo automaticamente)
DEMO_SEED=0

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# Processamento de documentos (fila persistente no Postgres)
# embedded = a API também processa os PDFs; external = um serviço `worker` separado (docker-compose)
JOB_WORKER=embedded
# OCR para PDFs escaneados (requer tesseract + dados dos idiomas; já incluídos no Dockerfile)
OCR_LANG=por+eng
OCR_DPI=200

# Busca e resumos
# Embeddings (busca por significado): local = modelo rodando no seu computador, sem internet (padrão);
# gemini = usa a API (precisa de chave e internet); none = só busca por palavras.
EMBED_PROVIDER=local
# Padrão: MiniLM multilíngue (~0,2 GB, cabe em PC de 8 GB). Mais qualidade: intfloat/multilingual-e5-large
# (~2,2 GB e ~2 GB de RAM por processo; API e worker são dois). Trocar o modelo exige reindexar a biblioteca.
LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Só para EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# SUMMARIZE_DOCS=1 gera resumo por documento com a IA (0 desliga). Precisa de LLM_API_KEY e internet.
SUMMARIZE_DOCS=1

# Operação local
# Aplica db/migrations ao iniciar (o docker-compose já ativa). Bancos antigos acompanham o código.
AUTO_MIGRATE=1
# E-mails (separados por vírgula) que podem ler GET /admin/errors, o registro local de erros. Vazio = ninguém.
ADMIN_EMAILS=
ERROR_RETENTION_DAYS=30
# Backup: docker compose run --rm backup create  (grava em ./backups, mantém os BACKUP_KEEP mais recentes)
BACKUP_KEEP=14
